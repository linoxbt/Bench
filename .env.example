# Copy to .env and fill in. Never commit .env. Testnet keys only.

# EVM keys (work on GenLayer Chain 4221 and, for Plan B, Base Sepolia 84532)
BENCH_BUYER_KEY=
BENCH_SELLER_KEY=
DEPLOYER_KEY=
# GenLayer (GenVM) key for deploy/judge/preview/appeal; falls back to the seller key in `bench judge`
GENLAYER_KEY=

# Set after deploying (see README)
BENCH_JUDGE=
BENCH_USD=

# Plan B (BenchJudgeB on Studionet + relayer)
# BENCH_PLAN=b
# BENCH_JUDGE_B=
# RELAYER_KEY=                       # a dedicated key: the oracle Plan B escrows name (never reuse the deployer key)

# Optional
# BENCH_NETWORK=studionet            # for `bench preview` / `bench cases` against the Studionet sandbox
# GENLAYER_RPC=https://rpc-bradbury.genlayer.com   # GenVM reads (gen_call); rpc.testnet-chain serves EVM methods only
# BENCH_HOME=~/.bench                # where unfinished deliveries (commit records) are kept
# GENLAYER_CHAIN_RPC=https://rpc.testnet-chain.genlayer.com
# BENCH_ALKAHEST_ADDRESSES={"trustedOracleArbiter":"0x..."}   # override Alkahest addresses (e.g. a redeploy)

# Web viewer (Vercel)
# NEXT_PUBLIC_BENCH_JUDGE=
# NEXT_PUBLIC_BENCH_JUDGE_STUDIONET=   # the free preview sandbox (contracts/studionet/bench_judge_preview.py)
# NEXT_PUBLIC_BENCH_USD=
# NEXT_PUBLIC_REOWN_PROJECT_ID=   # WalletConnect QR option; public ID, restrict it to your domains in the Reown dashboard

# Copy to .env and fill in. Never commit .env. Testnet keys only.

# EVM keys (work on GenLayer Chain 4221 and, for Plan B, Base Sepolia 84532)
BENCH_BUYER_KEY=
BENCH_SELLER_KEY=
DEPLOYER_KEY=
# GenLayer (GenVM) key for deploy/judge/preview/appeal; falls back to the seller key in `bench judge`
GENLAYER_KEY=

# Set after deploying (see README)
BENCH_JUDGE=
BENCH_USD=

# Optional
# BENCH_NETWORK=studionet            # for `bench preview` / `bench cases`
# GENLAYER_CHAIN_RPC=https://rpc.testnet-chain.genlayer.com
# BENCH_ALKAHEST_ADDRESSES={"trustedOracleArbiter":"0x..."}   # override Alkahest addresses (e.g. a redeploy)

# Web viewer (Vercel)
# NEXT_PUBLIC_BENCH_JUDGE=
# NEXT_PUBLIC_BENCH_USD=
# NEXT_PUBLIC_REOWN_PROJECT_ID=   # WalletConnect QR option; public ID, restrict it to your domains in the Reown dashboard

{
  "name": "bench",
  "private": true,
  "version": "0.1.0",
  "description": "Arkhai natural-language escrows judged by a GenLayer validator jury",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:contract": "GENVM_VERSION=v0.6.0-rc13 python scripts/genvm_lint.py contracts/bench_judge.py && GENVM_VERSION=v0.6.0-rc13 python scripts/genvm_lint.py contracts/probe/gate_probe.py",
    "lint:contract-b": "genvm-lint check contracts/bench_judge_b.py && genvm-lint check contracts/studionet/bench_judge_preview.py",
    "test:contract": "GENVM_VERSION=v0.6.0-rc13 pytest tests/direct -p gltest",
    "test:contract-b": "pytest tests/direct_b -p gltest",
    "e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "gate": "bash scripts/day1-gate.sh",
    "gate:probe": "tsx scripts/day1-gate-probe.ts",
    "deploy:judge": "tsx scripts/deploy-judge.ts",
    "deploy:token": "pnpm -F @bench/evm build && pnpm -F @bench/evm deploy:token",
    "test:local": "pnpm -F @bench/core build && pnpm -F @bench/cli build && vitest run --config tests/local/vitest.config.ts",
    "bench": "node packages/cli/dist/index.js",
    "deploy:alkahest": "tsx scripts/deploy-alkahest.ts",
    "deploy:judge-b": "tsx scripts/deploy-judge-b.ts",
    "relayer": "pnpm -F @bench/relayer build && node packages/relayer/dist/main.js",
    "test:web": "pnpm -F @bench/core build && tsx tests/web/wallet-e2e.ts",
    "test:web:live": "tsx tests/web/live-bradbury.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "alkahest-ts": "1.1.2",
    "genlayer-js": "2.0.0-rc.3",
    "genlayer-js-v02": "npm:genlayer-js@1.1.8",
    "hardhat": "2.29.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "viem": "2.57.17",
    "vitest": "5.1.0"
  }
}

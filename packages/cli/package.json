{
  "name": "@bench/cli",
  "version": "0.1.0",
  "description": "bench: create, deliver, judge and settle Arkhai escrows judged by a GenLayer jury",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bench": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "bench": "tsx src/index.ts"
  },
  "dependencies": {
    "@bench/core": "workspace:*",
    "commander": "15.1.0",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "@types/node": "22.20.5"
  }
}
